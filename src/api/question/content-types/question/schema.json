{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Question",
    "description": "One MCQ question. correctIndex must never be serialised to a student — see the take endpoint in the quiz controller."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "text": {
      "type": "string",
      "required": true
    },
    "options": {
      "type": "json",
      "required": true
    },
    "correctIndex": {
      "type": "integer",
      "required": true
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "questions"
    }
  }
}
