HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Allowed CORS origins, comma-separated. Defaults to http://localhost:3000.
FRONTEND_URLS=http://localhost:3000

# Database. Defaults to sqlite; this project uses postgres.
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cps_lms_database
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Managed Postgres (Neon, Railway, ...). When set, the URL overrides every
# DATABASE_* value above, so leave those unset in production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Seeded on every boot. Strapi refuses to start if these are missing.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme
INITIAL_ADMIN_NAME=Admin
